# ==============================================================================
# Modern AI-Powered Hospital Management — Environment Configuration
# ==============================================================================
# Quick Start:
#   1. Copy this file to the project root as `.env`:
#        cp .env.example .env
#   2. For local demo / evaluation, the defaults below work out-of-the-box with
#      PostgreSQL (via Docker Compose or local Postgres) even without live
#      Supabase or Gemini credentials.
#   3. Note for Vite Frontend (manual `npm run dev` without Docker):
#      Vite reads env vars from `frontend/.env` (or uses safe defaults:
#      VITE_API_BASE_URL=http://localhost:8000 and VITE_ENABLE_DEMO_LOGIN=true).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Hospital Operations AI Agent"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
TIMEZONE=Asia/Kolkata            # Used for "last month", "today", and IST billing dates

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database
# ------------------------------------------------------------------------------
# Used by FastAPI SQLAlchemy & Alembic migrations.
# Accepts postgres://, postgresql://, or postgresql+psycopg:// URIs.
# - Docker Compose: postgresql+psycopg://postgres:postgres@postgres:5432/hospital_ai
# - Local Postgres: postgresql+psycopg://postgres:postgres@localhost:5432/hospital_ai
# - Supabase:       Use the Session Pooler URI (port 5432) from Supabase Connect modal
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hospital_ai

# Optional: Live PostgreSQL database URL for running pytest against real Postgres + RLS.
# Leave blank to run pytest with its built-in isolated SQLite test database.
TEST_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Authentication (Demo Auth & Supabase Auth)
# ------------------------------------------------------------------------------
# Set ALLOW_DEMO_AUTH=true for local development, evaluation, and demo role switching.
# IMPORTANT: Set ALLOW_DEMO_AUTH=false in strict production environments using Supabase Auth.
ALLOW_DEMO_AUTH=true
DEMO_JWT_SECRET=change-me-local-dev-demo-jwt-secret-at-least-32-chars
DEMO_USER_PASSWORD=HospitalDemo!2026

# Optional in Demo Mode; Required for Live Supabase Auth JWT Verification
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 4. Write Confirmation Tokens & Guardrails
# ------------------------------------------------------------------------------
# HMAC secret used to bind dry-run previews to user_id, hospital_id, and payload hash
CONFIRMATION_TOKEN_SECRET=change-me-confirmation-secret-at-least-32-chars
CONFIRMATION_TTL_SECONDS=600     # Preview expiry window in seconds (default: 10 minutes)

# ------------------------------------------------------------------------------
# 5. Google Gemini AI (Optional for Local Evaluation)
# ------------------------------------------------------------------------------
# With GEMINI_API_KEY set: uses Google GenAI SDK structured JSON output extraction.
# Without GEMINI_API_KEY: falls back to the deterministic schema-validated local parser
# so evaluators can run all scenarios, Telugu/Hinglish queries, and evals offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROMPT_VERSION=v1.0.0

# ------------------------------------------------------------------------------
# 6. CORS (Backend -> Allowed Frontend Origins)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (NO trailing slashes).
# In production, include your Vercel/frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Frontend (Vite Build-Time / Dev Variables)
# ------------------------------------------------------------------------------
# Used by Docker Compose frontend build args and Vercel environment variables.
# If running `cd frontend && npm run dev` manually, place overrides in `frontend/.env`.
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_DEMO_LOGIN=true
