# Application
APP_NAME="Hospital Operations AI Agent"
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Database (Supabase PostgreSQL or local PostgreSQL via Docker)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hospital_ai
TEST_DATABASE_URL=

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# For local development/testing without live Supabase Auth, set ALLOW_DEMO_AUTH=true
ALLOW_DEMO_AUTH=true
DEMO_JWT_SECRET=change-me-local-dev-secret-at-least-32-chars

# Confirmation Token Signing
CONFIRMATION_TOKEN_SECRET=change-me-confirmation-secret-at-least-32-chars
CONFIRMATION_TTL_SECONDS=600

# Gemini AI (Google GenAI SDK)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
PROMPT_VERSION=v1.0.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ENABLE_DEMO_LOGIN=true

